  "autoAssess": {
    "_comment": "Perimeter-opposition crop/GC picker (LazyStretch.js:2544-2636). sigma is the STF shadows clip in avgDev units used for the visual-space mapping; dropBrightest=1 uses the 2nd-brightest perimeter patch as the bright reference.",
    "sigma": -2.8,
